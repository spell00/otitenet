{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Otitenet",
  "version": "0.9.0",
  "identifier": "com.otitenet.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Otitenet",
        "label": "main",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/otitenet-streamlit"
    ],
    "resources": [
      "binaries/otitenet-streamlit-runtime"
    ]
  }
}
